generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  customers   Customer[]
  enquiries   Enquiry[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           String   @default("Member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
}

model Customer {
  id             String @id @default(cuid())
  organisationId String

  customerNumber String
  firstName      String @default("")
  surname        String @default("")
  fullName       String @default("")

  address     String @default("")
  postcode    String @default("")
  email       String @default("")
  homePhone   String @default("")
  mobilePhone String @default("")

  lawnSize       Int     @default(0)
  groupNumber    Int     @default(0)
  treatmentPrice Decimal @db.Decimal(10, 2)

  status    String @default("Active")
  vanNumber Int    @default(1)

  nextVisit String @default("Not yet scheduled")
  lastVisit String @default("No previous visit")

  lockedGate    Boolean @default(false)
  gateCode      String  @default("")
  dogOnProperty Boolean @default(false)

  preferredContact String @default("SMS")
  paymentMethod    String @default("Not set")

  notes              String @default("")
  programmeStartDate String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  additionalJobs AdditionalCustomerJob[]

  @@unique([organisationId, customerNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, postcode])
}

model AdditionalCustomerJob {
  id         String @id @default(cuid())
  customerId String

  treatmentLibraryId String
  treatmentName      String
  wordingSnapshot    String  @default("")
  scheduledDate      String
  price              Decimal @db.Decimal(10, 2)
  status             String
  notes              String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, status])
}

model Enquiry {
  id             String @id
  organisationId String

  enquiryNumber String

  status     String @default("New Enquiry")
  source     String @default("Recommendation")
  referredBy String @default("")

  firstName String @default("")
  surname   String @default("")
  fullName  String @default("")

  address  String @default("")
  postcode String @default("")

  emailAddress String @default("")
  homePhone    String @default("")
  mobilePhone  String @default("")

  initialMessage String @default("")
  internalNotes  String @default("")

  siteVisitDate String @default("")
  siteVisitTime String @default("")

  lawnMeasured         Boolean @default(false)
  lawnSizeSquareMetres Int     @default(0)

  minimumPriceApplied      Boolean @default(false)
  pricePerSquareMetre      Decimal @default(0.20) @db.Decimal(10, 2)
  calculatedTreatmentPrice Decimal @default(0) @db.Decimal(10, 2)
  quotedTreatmentPrice     Decimal @default(0) @db.Decimal(10, 2)

  quoteStatus     String @default("Not Prepared")
  quoteDate       String @default("")
  quoteExpiryDate String @default("")
  quoteNotes      String @default("")

  treatmentStartedImmediately Boolean @default(false)

  suggestedGroupNumber Int @default(1)
  suggestedVanNumber   Int @default(1)

  extraWorkRequired        Boolean @default(false)
  extraWorkDescription     String  @default("")
  preferredExtraWorkSeason String  @default("")

  convertedCustomerNumber String @default("")
  convertedAt             String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, enquiryNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, quoteStatus])
  @@index([organisationId, postcode])
}
