generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            Membership[]
  customers              Customer[]
  enquiries              Enquiry[]
  seasons                Season[]
  programmes             Programme[]
  routeOrders            RouteOrder[]
  treatments             Treatment[]
  chemicals              Chemical[]
  chemicalStockMovements ChemicalStockMovement[]
  workingDays            WorkingDay[]
  communications         Communication[]
  customerActions        CustomerAction[]
  auditEntries           AuditEntry[]
  settings               OrganisationSettings?
  invoiceSequence        InvoiceSequence?
  customerSequence       CustomerSequence?
  enquirySequence        EnquirySequence?
}

model Season {
  id             String @id
  organisationId String

  year Int
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, year])
  @@index([organisationId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           String   @default("Member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
}

model Customer {
  id             String @id @default(cuid())
  organisationId String

  customerNumber String
  title          String @default("")
  firstName      String @default("")
  surname        String @default("")
  fullName       String @default("")

  address     String @default("")
  postcode    String @default("")
  email       String @default("")
  homePhone   String @default("")
  mobilePhone String @default("")

  lawnSize       Int     @default(0)
  groupNumber    Int     @default(0)
  treatmentPrice Decimal @db.Decimal(10, 2)

  status    String @default("Active")
  vanNumber Int    @default(1)

  nextVisit String @default("Not yet scheduled")
  lastVisit String @default("No previous visit")

  lockedGate    Boolean @default(false)
  gateCode      String  @default("")
  dogOnProperty Boolean @default(false)

  preferredContact String @default("SMS")
  paymentMethod    String @default("Not set")

  notes              String @default("")
  programmeStartDate String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  additionalJobs AdditionalCustomerJob[]
  programmes     Programme[]
  lawnAreas      CustomerLawnArea[]

  @@unique([organisationId, customerNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, postcode])
}


model CustomerLawnArea {
  id         String @id @default(cuid())
  customerId String

  name         String @default("")
  areaSquareMetres Int @default(0)
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, displayOrder])
}

model EnquiryLawnArea {
  id        String @id @default(cuid())
  enquiryId String

  name             String @default("")
  areaSquareMetres Int    @default(0)
  displayOrder     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([enquiryId, displayOrder])
}

model AdditionalCustomerJob {
  id         String @id @default(cuid())
  customerId String

  treatmentLibraryId String
  treatmentName      String
  wordingSnapshot    String  @default("")
  scheduledDate      String
  price              Decimal @db.Decimal(10, 2)
  status             String
  notes              String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, status])
}

model Enquiry {
  id             String @id
  organisationId String

  enquiryNumber String

  status     String @default("New Enquiry")
  source     String @default("Recommendation")
  referredBy String @default("")

  title     String @default("")
  firstName String @default("")
  surname   String @default("")
  fullName  String @default("")

  address  String @default("")
  postcode String @default("")

  emailAddress String @default("")
  homePhone    String @default("")
  mobilePhone  String @default("")

  initialMessage String @default("")
  internalNotes  String @default("")

  siteVisitDate String @default("")
  siteVisitTime String @default("")

  lawnMeasured         Boolean @default(false)
  lawnSizeSquareMetres Int     @default(0)

  minimumPriceApplied      Boolean @default(false)
  pricePerSquareMetre      Decimal @default(0.20) @db.Decimal(10, 2)
  calculatedTreatmentPrice Decimal @default(0) @db.Decimal(10, 2)
  quotedTreatmentPrice     Decimal @default(0) @db.Decimal(10, 2)

  quoteStatus     String @default("Not Prepared")
  quoteDate       String @default("")
  quoteExpiryDate String @default("")
  quoteNotes      String @default("")

  treatmentStartedImmediately Boolean @default(false)

  suggestedGroupNumber Int @default(1)
  suggestedVanNumber   Int @default(1)

  extraWorkRequired        Boolean @default(false)
  extraWorkDescription     String  @default("")
  preferredExtraWorkSeason String  @default("")

  convertedCustomerNumber String @default("")
  convertedAt             String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lawnAreas     EnquiryLawnArea[]

  @@unique([organisationId, enquiryNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, quoteStatus])
  @@index([organisationId, postcode])
}

model Programme {
  id             String @id
  organisationId String
  customerId     String

  year Int
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, year])
  @@index([organisationId])
  @@index([organisationId, year])
  @@index([customerId])
}

model RouteOrder {
  id             String @id @default(cuid())
  organisationId String

  date            String
  vanNumber       Int
  customerNumbers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, date, vanNumber])
  @@index([organisationId, date])
}

model Chemical {
  id             String @id
  organisationId String

  name   String  @default("")
  active Boolean @default(true)
  data   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationId, active])
  @@index([organisationId, name])
}

model ChemicalStockMovement {
  id             String @id
  organisationId String

  chemicalId String
  date       String @default("")
  data       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationId, chemicalId])
  @@index([organisationId, date])
}

model Treatment {
  id             String @id
  organisationId String

  customerNumber          String
  programmeId             String @default("")
  programmeVisitId        String @default("")
  invoiceNumberNormalized String @default("")
  recordedDate            String @default("")
  data                    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, customerNumber])
  @@index([organisationId, recordedDate])
}

model WorkingDay {
  id             String @id
  organisationId String
  date           String

  chemicalsChecked   Boolean @default(false)
  quickbooksExported Boolean @default(false)
  closed             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, date])
  @@index([organisationId])
  @@index([organisationId, date])
}

model Communication {
  id             String @id
  organisationId String

  customerNumber String
  customerName   String @default("")
  channel        String
  status         String
  subject        String @default("")
  message        String @default("")
  scheduledDate  String
  treatmentName  String @default("")
  jobType        String
  sentAt         String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationId, scheduledDate])
  @@index([organisationId, customerNumber])
  @@index([organisationId, status])
}

model CustomerAction {
  id             String @id
  organisationId String

  customerNumber String
  customerName   String @default("")
  type           String
  priority       String
  status         String
  dueDate        String @default("")
  note           String @default("")
  completedAt    String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationId, customerNumber])
  @@index([organisationId, status])
  @@index([organisationId, dueDate])
}

model AuditEntry {
  id             String @id
  organisationId String

  user          String
  area          String
  action        String
  reference     String
  description   String
  changedFields Json

  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationId, createdAt])
  @@index([organisationId, area])
  @@index([organisationId, action])
}

model OrganisationSettings {
  id             String @id
  organisationId String @unique
  data           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model InvoiceSequence {
  id             String @id
  organisationId String @unique
  nextNumber     Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model CustomerSequence {
  id             String @id
  organisationId String @unique
  nextNumber     Int    @default(1001)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model EnquirySequence {
  id             String @id
  organisationId String @unique
  nextNumber     Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}
